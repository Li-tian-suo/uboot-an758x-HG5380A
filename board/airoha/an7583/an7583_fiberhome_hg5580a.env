#include <env/airoha/an758x.env>
#include <env/airoha/an758x-ubi.env>
loadaddr=0x90000000
console=earlycon=uart8250,mmio32,0x1fbf0000 console=ttyS0
bootfile=ponwrt-airoha-an7583-fiberhome_hg5580a-initramfs-recovery.itb
bootfile_bl2=an7583-fiberhome-hg5580a-preloader.bin
bootfile_fip=an7583-fiberhome-hg5580a-bl31-u-boot.fip
bootfile_upg=ponwrt-airoha-an7583-fiberhome_hg5580a-squashfs-sysupgrade.itb
bootled_status=green:power
bootmenu_title=U-Boot HG5580A
preboot=led $bootled_status on ; run ethaddr_factory
# The "ri" volume on this board starts with the base MAC at offset 0x00, not
# 0x3e as on the Nokia layout this line was copied from:
#   0x00  6 bytes  base MAC
#   0x06  6 bytes  LAN / 2.5G MAC
#   0x0c  8 bytes  PON serial
#   0x14  6 bytes  PON MAC
# Reading 0x3e here yields a garbage address, which shows up as
# "using random MAC address" at every boot.
ethaddr_factory=run ubi_mount && ubi read 0x90000000 ri && env readmem -b ethaddr 0x90000000 0x6
