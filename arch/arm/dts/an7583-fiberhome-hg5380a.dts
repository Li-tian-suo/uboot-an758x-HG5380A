/*
 * FiberHome HG5380A — Airoha AN7583
 *
 * 由原厂 KernelA 内的 DTB 反编译结果整理；分区表与 /proc/mtd 一致。
 * 本机无 WiFi / 无 USB / 无语音：3×GE + 1×2.5G(EN8811H) + 1×PON(EN7572 BOSA)。
 *
 * TODO(上机核对)：reset 键与 LED 的 GPIO 号（当前沿用 AN7583 参考板的取值）。
 */
/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7583.dtsi"

/ {
	model = "FiberHome HG5380A";
	compatible = "fiberhome,hg5380a", "airoha,an7583";

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x1fe00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&an7583_pinctrl 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "green:wan";
			gpios = <&an7583_pinctrl 6 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			label = "green:internet";
			gpios = <&an7583_pinctrl 7 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			label = "green:power";
			gpios = <&an7583_pinctrl 25 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			label = "red:los";
			gpios = <&an7583_pinctrl 27 GPIO_ACTIVE_LOW>;
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x280000>;
		};

		partition@280000 {
			label = "bootflag";
			reg = <0x280000 0x80000>;
		};

		partition@300000 {
			label = "KernelA";
			reg = <0x300000 0x600000>;
		};

		partition@900000 {
			label = "RootfsA";
			reg = <0x900000 0x2800000>;
		};

		partition@3100000 {
			label = "KernelB";
			reg = <0x3100000 0x600000>;
		};

		partition@3700000 {
			label = "RootfsB";
			reg = <0x3700000 0x2800000>;
		};

		partition@5f00000 {
			label = "apps";
			reg = <0x5f00000 0x6800000>;
		};

		partition@c700000 {
			label = "frameworka";
			reg = <0xc700000 0x1000000>;
		};

		partition@d700000 {
			label = "frameworkb";
			reg = <0xd700000 0x1000000>;
		};

		partition@e700000 {
			label = "factory";
			reg = <0xe700000 0x500000>;
		};
	};
};

&i2c0 {
	status = "okay";
};

&gdm1 {
	status = "okay";
};
